# ============================================================
# daniya-fansite 服务器环境变量模板
# 使用：cp .env.production.example ../.env.production  然后填写
# ⚠️ .env.production 在 .gitignore 中，绝不会提交到 Git
# ============================================================

# ---- 必配项 ----
# 生成命令：openssl rand -base64 32
AUTH_SECRET=你的AUTH_SECRET

# Neon Serverless PostgreSQL（与本地 .env.local 相同，直接复制）
# Pooled 连接（带 -pooler，运行时查询用）
DATABASE_URL=postgresql://user:password@host-neon-pooler/neondb?sslmode=require
# Direct 连接（不带 -pooler，Prisma migrations 用）
DIRECT_URL=postgresql://user:password@host-neon/neondb?sslmode=require

# 站点访问地址（无域名时填 http://服务器IP；有域名后改 https://你的域名）
AUTH_URL=http://你的服务器IP

# 管理员用户 ID — 注册后到数据库 User 表查你的用户 ID 填入
ADMIN_USER_ID=你的ADMIN_USER_ID

# ---- 图床（ImgURL）----
IMGURL_UID=你的IMGURL_UID
IMGURL_TOKEN=你的IMGURL_TOKEN

# ---- AI 聊天（智谱，默认模型免费）----
ZHIPU_API_KEY=你的ZHIPU_API_KEY
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_DEFAULT_MODEL=glm-4.7-flash
CHAT_DAILY_QUOTA_PER_USER=200
CHAT_MAX_OUTPUT_TOKENS=50
USER_KEY_ENCRYPTION_SALT=daniya-custom-ai-v1
