# 依赖
node_modules/
# Next.js 构建输出
.next/
# 环境变量（含密钥）
.env
.env.local
.env.production
.env*.local
# Prisma 数据库文件（已改为 Neon PostgreSQL，不再使用本地 SQLite）
prisma/*.db
# 背景图原图（10k PNG，954MB）不入库 — 站点只请求 thumbs/window/desktop 三个子目录（14MB）
# 原图仅本地持有；git 历史中仍有备份，可随时 git show 恢复
public/背景图片/*
!public/背景图片/thumbs/
!public/背景图片/window/
!public/背景图片/desktop/
# 操作系统
.DS_Store
Thumbs.db
# IDE
.vscode/
.idea/
# 调试
npm-debug.log*
# Claude Code 本地调试产物（含会话截图/令牌，勿提交）
.claude/csrf.json
.claude/jar.txt
.claude/submit-check.*
.claude/submit-logged.html
.claude/submit-raw.html
